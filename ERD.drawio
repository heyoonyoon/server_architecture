y"/></mxCell><mxCell id="c49" value="id" style="fontSize=14;html=1;whiteSpace=wrap;ellipse;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="10" y="860" width="90" height="44" as="geometry"/></mxCell><mxCell id="c50" value="" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c47" target="c49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="name" style="fontSize=14;html=1;whiteSpace=wrap;ellipse;" vertex="1" parent="1"><mxGeometry x="130" y="860" width="90" height="44" as="geometry"/></mxCell><mxCell id="c52" value="" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c47" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c53" value="개설" style="fontSize=14;html=1;whiteSpace=wrap;rhombus;double=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="548" width="90" height="80" as="geometry"/></mxCell><mxCell id="c54" value="M" style="shape=link;endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c55" value="Course" style="fontSize=14;html=1;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="890" y="560" width="130" height="56" as="geometry"/></mxCell><mxCell id="c56" value="1" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c53" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="id" style="fontSize=14;html=1;whiteSpace=wrap;ellipse;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="830" y="690" width="90" height="44" as="geometry"/></mxCell><mxCell id="c58" value="" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c55" target="c57"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="name" style="fontSize=14;html=1;whiteSpace=wrap;ellipse;" vertex="1" parent="1"><mxGeometry x="940" y="700" width="90" height="44" as="geometry"/></mxCell><mxCell id="c60" value="" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c55" target="c59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c61" value="학점" style="fontSize=14;html=1;whiteSpace=wrap;ellipse;" vertex="1" parent="1"><mxGeometry x="1050" y="690" width="90" height="44" as="geometry"/></mxCell><mxCell id="c62" value="" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c55" target="c61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="선수" style="fontSize=14;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1130" y="760" width="90" height="80" as="geometry"/></mxCell><mxCell id="c64" value="M (선수과목)" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c55" target="c63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c65" value="M (후수과목)" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c63" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;표기법 (Chen)&lt;/b&gt;&lt;br&gt;네모: 엔티티 / 이중 네모: 약한 엔티티&lt;br&gt;마름모: 관계 / 이중 마름모: 식별 관계&lt;br&gt;동그라미: 속성 / 밑줄: 키 / 점선 밑줄: 부분키&lt;br&gt;이중 동그라미: 다중값 속성&lt;br&gt;이중선: 전체 참여" style="fontSize=14;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;strokeColor=#999999;fillColor=#f5f5f5;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="330" height="140" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b&gt;제약 조건&lt;/b&gt;&lt;br&gt;1. 수강.성적은 상태가 이수완료 또는 낙제일 때만 값이 있다 (그 외에는 NULL).&lt;br&gt;2. 같은 학생은 같은 개설강의를 한 번만 수강할 수 있다.&lt;br&gt;3. 개설강의의 수강 인원은 정원을 넘을 수 없다.&lt;br&gt;4. 학생은 주전공이 정확히 하나다.&lt;br&gt;5. 개설강의는 Course + 학기 + 분반 번호로 식별된다." style="fontSize=14;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;strokeColor=#999999;fillColor=#f5f5f5;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="990" width="560" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>