20" value="M" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="성적&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;(nullable)&lt;/font&gt;" style="fontSize=14;html=1;whiteSpace=wrap;ellipse;" vertex="1" parent="1"><mxGeometry x="690" y="370" width="100" height="50" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="상태&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;(신청, 수강중, 이수완료, 낙제, 철회)&lt;/font&gt;" style="fontSize=14;html=1;whiteSpace=wrap;ellipse;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="신청 시각" style="fontSize=14;html=1;whiteSpace=wrap;ellipse;" vertex="1" parent="1"><mxGeometry x="390" y="410" width="100" height="44" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="개설강의" style="fontSize=14;html=1;whiteSpace=wrap;shape=ext;double=1;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="560" width="140" height="56" as="geometry"/></mxCell><mxCell id="c28" value="M" style="endArrow=none;html=1;rounded=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="&lt;span style=&q