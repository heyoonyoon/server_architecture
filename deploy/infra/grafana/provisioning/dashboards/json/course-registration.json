      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "expr": "round(sum(increase(envoy_cluster_grpc_Enroll_success{envoy_cluster_name=\"enrollment\"}[$__range]))) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
